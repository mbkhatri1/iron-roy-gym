# Railway sets PORT automatically. Do not commit real secret values.
NODE_ENV=production
WEB_DIST_DIR=artifacts/gym-management/dist/public

# Required by Clerk on the API server.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Required at frontend build time. Add this in Railway Variables so it is
# available during the Nixpacks build.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. Leave empty to use Clerk directly, or set this to /api/__clerk
# when using the API's Clerk proxy.
VITE_CLERK_PROXY_URL=

# Add this when PostgreSQL persistence is wired into the demo.
# DATABASE_URL=