# The container listens on 8080. GoDaddy's reverse proxy should expose HTTPS.
NODE_ENV=production
WEB_DIST_DIR=/app/public

# Clerk server configuration.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# This is embedded into the frontend during docker build.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Add this after PostgreSQL persistence is implemented.
# DATABASE_URL=